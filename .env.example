# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-with-at-least-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database Configuration (Neon PostgreSQL in Production, Local PostgreSQL in Dev)
# Local: postgresql://deep_sea_user:password@127.0.0.1:5432/deep_sea_explorer
# Neon: postgresql://[user]:[password]@[endpoint-id].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Render Variables (Render tự động cung cấp hoặc có thể cấu hình thủ công)
# RENDER_EXTERNAL_HOSTNAME=the-deep-sea-explorer.onrender.com
# RENDER_EXTERNAL_URL=https://the-deep-sea-explorer.onrender.com
